# Configuración de API para obtener configuración de tienda
# Esta URL debe apuntar al endpoint que devuelve la configuración
REACT_APP_CONFIG_API=https://tu-api.com/api/v1/store/config

# ID de la tienda para obtener configuración específica
# Este valor debe ser único para cada tienda
REACT_APP_STORE_ID=store_123

# Configuración opcional para desarrollo
REACT_APP_ENV=development

# URLs de API principales (si las necesitas)
EXPO_PUBLIC_API_URL=https://tu-api-backend.azurewebsites.net

# Configuración de Firebase (ejemplo)
EXPO_PUBLIC_FIREBASE_API_KEY=your-firebase-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id

# ===================================================================
# INSTRUCCIONES DE USO:
# ===================================================================
#
# 1. Renombra este archivo a .env
# 2. Actualiza las URLs con tus endpoints reales
# 3. Configura el REACT_APP_STORE_ID con el ID de tu tienda
# 4. Asegúrate de que tu API devuelva la configuración en el formato esperado:
#
# {
#   "success": true,
#   "data": {
#     "storeId": "store_123",
#     "business": {
#       "name": "Mi Tienda",
#       "description": "La mejor tienda online",
#       "address": "Calle Principal 123",
#       "phone": "+1234567890",
#       "email": "contacto@mitienda.com"
#     },
#     "branding": {
#       "primaryColor": "#3B82F6",
#       "secondaryColor": "#F59E0B", 
#       "accentColor": "#8B5CF6",
#       "logoUrl": "https://tu-cdn.com/logo.png"
#     },
#     "currency": {
#       "code": "USD",
#       "symbol": "$",
#       "decimalPlaces": 2
#     },
#     "modules": {
#       "offers": true,
#       "loyalty": true,
#       "reviews": false,
#       "wishlist": true
#     }
#   }
# }
#
# 5. El servicio automáticamente:
#    - Guardará la configuración en cache por 24 horas
#    - Usará mock data si la API no responde
#    - Fallback a configuración por defecto si hay errores
#
# ===================================================================